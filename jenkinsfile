pipeline {
  agent any

  stages {

    stage('Checkout') {
      steps {
        git branch: 'master',
            url: 'https://github.com/TAPASHRANJANNANDI/Kool.git'
      }
    }

    stage('Build and Push Docker Image') {
      environment {
        DOCKER_IMAGE = "tapashranjannandi/kool:${BUILD_NUMBER}"
      }
      steps {
        script {
          sh "docker build -t ${DOCKER_IMAGE} ."
          docker.withRegistry('https://index.docker.io/v1/', 'docker-cred') {
            docker.image("${DOCKER_IMAGE}").push()
          }
        }
      }
    }

    stage('Update Deployment File') {
      steps {
        withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
          sh '''
            echo "Workspace content:"
            ls -R

            sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" k8s/deployment.yaml

            git config user.email "tapash@gmail.com"
            git config user.name "Tapash"

            git add k8s/deployment.yaml
            git commit -m "Update image tag to ${BUILD_NUMBER}" || echo "No changes to commit"
            git push https://${GITHUB_TOKEN}@github.com/TAPASHRANJANNANDI/Kool.git master
          '''
        }
      }
    }

  }
}
